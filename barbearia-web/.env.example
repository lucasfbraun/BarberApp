# =====================================================================
# Template de variaveis de ambiente — COPIE para .env.local e preencha.
# NUNCA coloque segredos reais neste arquivo (.env.example e versionado).
# Arquivos .env e .env.local sao ignorados pelo Git.
# =====================================================================

# Conexao com o banco (Postgres). Em producao, use a connection string do provedor.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=require"

# Segredo de assinatura do NextAuth (JWT).
# Gere um valor forte e unico por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA use um placeholder em producao.
NEXTAUTH_SECRET="GERE_UM_SEGREDO_FORTE_E_UNICO"

# URL publica da aplicacao (sem barra no final).
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# Login social do CLIENTE FINAL (opcional). Ver AUTH.md para o passo a
# passo de criacao dos apps. Se as variaveis de um provedor estiverem
# vazias, o botao dele simplesmente nao aparece — o app continua
# funcionando com e-mail e senha.
# ---------------------------------------------------------------------

# Google Cloud > APIs e servicos > Credenciais > ID do cliente OAuth (Web).
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook Developers > Meu app > Configuracoes > Basico.
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ---------------------------------------------------------------------
# E-mail transacional — usado pela recuperacao de senha.
#
# SEM ESTAS VARIAVEIS:
#   - em desenvolvimento, o link de redefinicao e IMPRESSO no console do
#     servidor (procure o bloco "E-MAIL (modo desenvolvimento)"). Da para
#     testar o fluxo inteiro sem conta de provedor;
#   - em PRODUCAO, o pedido de redefinicao falha com erro explicito. Um
#     e-mail que silenciosamente nao sai e pior do que um erro.
#
# O envio e feito por HTTP com `fetch`, sem SDK — trocar de provedor e
# mexer so em src/lib/mailer.ts.
# ---------------------------------------------------------------------

# Chave da API do Resend (resend.com > API Keys).
RESEND_API_KEY=""

# Remetente. Precisa ser um endereco de dominio VERIFICADO no provedor,
# senao o envio e recusado.
MAIL_FROM="nao-responda@seudominio.com.br"
